# Copy to .env and fill in. .env is gitignored; config.toml is not, so anything
# personal belongs here rather than there.

# Who the receipt is for. Personas address you by name, and some print it.
QG_NAME=Sam

# Where you are. Overrides [location] in config.toml.
# Coordinates to 4 decimal places is ~11m, which is far more than the weather
# needs - round them off. `python tools/checklocation.py` checks they are where
# the name says.
QG_LATITUDE=51.5074
QG_LONGITUDE=-0.1278
QG_LOCATION_NAME=London

# The city to search for things to do in (95, what's on tonight). Separate from
# the location name because the weather wants the suburb and the listings want
# the city it hangs off. Falls back to QG_LOCATION_NAME when unset.
# QG_CITY=London

# The narrator. Without a key every section prints its own templated copy.
# ANTHROPIC_API_KEY=
#
# Only needed if the key above is NOT scoped to a workspace. The API returns a
# 400 telling you so. Either create a workspace-scoped key in the Console, or
# put the workspace id here.
# ANTHROPIC_WORKSPACE_ID=

# The input channel (SYSTEM.md 6): a dedicated mailbox read over IMAP with an
# app password (Gmail: turn on 2-step verification, then Security -> App
# passwords). Left commented so a fresh clone does not try to log in with a
# placeholder.
# QG_IMAP_HOST=imap.gmail.com
# QG_IMAP_USER=
# QG_IMAP_APP_PASSWORD=

# Your birthday as DD-MM-YYYY. Drives the one-day-only birthday section (118)
# and days alive (44).
# QG_BIRTHDAY=15-06-1990

# Friends' timezones for slot 72, as comma-separated IANA zone names. The city
# printed is the zone's own (America/New_York -> New York), and its
# temperature is looked up by that name. A name the tz database does not know
# is dropped on its own.
# TIMEZONES=America/New_York,Asia/Tokyo,Australia/Sydney

# Contact details for the User-Agent sent to Wikipedia, OpenStreetMap and the
# other sources this reads - their policies ask for a way to reach you. A URL
# or an email address.
# QG_CONTACT=https://github.com/you/quick-guthe
